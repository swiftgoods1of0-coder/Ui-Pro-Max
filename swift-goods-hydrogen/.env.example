# Shopify Storefront API — get these from your Shopify admin:
# Online Store → Headless → Storefront API
PUBLIC_STORE_DOMAIN=swiftgoodsclothing.myshopify.com
PUBLIC_STOREFRONT_API_TOKEN=your_public_storefront_token_here

# Optional: Private token for server-side queries (higher rate limits)
PRIVATE_STOREFRONT_API_TOKEN=your_private_storefront_token_here

# Optional: Shopify Storefront ID (shown in Shopify admin)
PUBLIC_STOREFRONT_ID=

# Session secret (any long random string)
SESSION_SECRET=your_session_secret_here
