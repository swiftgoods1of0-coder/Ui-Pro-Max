{%- assign text_color = section.settings.text_color | default: '#f0ebe0' -%}
{%- assign use_3d = section.settings.enable_3d -%}
{%- assign spline_url = section.settings.spline_url -%}

<section
  class="hero hero--align-{{ section.settings.text_alignment }}"
  id="hero-{{ section.id }}"
  data-section-id="{{ section.id }}"
  style="
    color: {{ text_color }};
    min-height: clamp(600px, {{ section.settings.min_height }}svh, 100svh);
  "
>

  <!-- ── Background Media ──────────────────────────────────────── -->
  <div class="hero__media" id="hero-media-{{ section.id }}">

    {%- if use_3d and spline_url != blank -%}
      <!-- Spline 3D embed: src set by JS only on non-touch devices -->
      <div class="hero__spline" id="hero-spline-{{ section.id }}" aria-hidden="true">
        <iframe
          data-src="{{ spline_url }}"
          frameborder="0"
          width="100%"
          height="100%"
          title="3D brand experience"
          style="position:absolute;inset:0;width:100%;height:100%;border:none;"
        ></iframe>
      </div>

      <!-- Spline fallback: always visible until Spline resolves -->
      {%- if section.settings.fallback_image != blank -%}
        <div class="hero__spline-fallback" id="hero-spline-fallback-{{ section.id }}">
          {{
            section.settings.fallback_image
            | image_url: width: 1920
            | image_tag:
              loading: 'eager',
              fetchpriority: 'high',
              widths: '800,1200,1600,1920',
              sizes: '100vw',
              width: section.settings.fallback_image.width,
              height: section.settings.fallback_image.height,
              alt: section.settings.fallback_image.alt | default: shop.name
          }}
        </div>
      {%- endif -%}

    {%- elsif section.settings.video_url != blank -%}
      <!-- Video background -->
      <video
        src="{{ section.settings.video_url }}"
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        data-autoplay
        aria-hidden="true"
        {%- if section.settings.fallback_image != blank -%}
          poster="{{ section.settings.fallback_image | image_url: width: 1920 }}"
        {%- endif -%}
      ></video>

    {%- elsif section.settings.fallback_image != blank -%}
      <!-- Static image background -->
      {{
        section.settings.fallback_image
        | image_url: width: 1920
        | image_tag:
          loading: 'eager',
          fetchpriority: 'high',
          widths: '800,1200,1600,1920',
          sizes: '100vw',
          width: section.settings.fallback_image.width,
          height: section.settings.fallback_image.height,
          alt: section.settings.fallback_image.alt | default: shop.name
      }}

    {%- else -%}
      <!-- Gradient placeholder -->
      <div style="width:100%;height:100%;background:linear-gradient(160deg,#0a0a0a 0%,#1c1c1c 50%,#0a0a0a 100%);"></div>
    {%- endif -%}

  </div>

  <!-- ── Overlay ───────────────────────────────────────────────── -->
  <div
    class="hero__overlay"
    style="background:{{ section.settings.overlay_color | default: '#000000' }};opacity:{{ section.settings.overlay_opacity | divided_by: 100.0 }};"
    aria-hidden="true"
  ></div>

  <!-- ── Content ───────────────────────────────────────────────── -->
  <div class="hero__content container">

    {%- if section.settings.eyebrow != blank -%}
      <span class="hero__eyebrow" data-animate>{{ section.settings.eyebrow }}</span>
    {%- endif -%}

    {%- if section.settings.headline != blank -%}
      <h1 class="hero__headline" data-animate data-animate-delay="1" style="color:{{ text_color }};">
        {{ section.settings.headline | newline_to_br }}
      </h1>
    {%- endif -%}

    {%- if section.settings.subtext != blank -%}
      <p class="hero__subtext" data-animate data-animate-delay="2">
        {{ section.settings.subtext }}
      </p>
    {%- endif -%}

    {%- if section.settings.cta_primary_label != blank or section.settings.cta_secondary_label != blank -%}
      <div class="hero__actions" data-animate data-animate-delay="3">
        {%- if section.settings.cta_primary_label != blank -%}
          <a href="{{ section.settings.cta_primary_url | default: routes.collections_url }}" class="btn btn--primary btn--lg">
            {{ section.settings.cta_primary_label }}
          </a>
        {%- endif -%}
        {%- if section.settings.cta_secondary_label != blank -%}
          <a href="{{ section.settings.cta_secondary_url | default: routes.collections_url }}" class="btn btn--secondary btn--lg">
            {{ section.settings.cta_secondary_label }}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}

  </div>

  <!-- ── Scroll Indicator ──────────────────────────────────────── -->
  {%- if section.settings.show_scroll_indicator -%}
    <div class="hero__scroll" aria-hidden="true">
      <div class="hero__scroll-line"></div>
      <span class="hero__scroll-text">Scroll</span>
    </div>
  {%- endif -%}

</section>

<style>
  #hero-{{ section.id }} {
    position: relative;
    width: 100%;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    padding-top: var(--nav-height);
  }

  /* Spline iframe container */
  #hero-spline-{{ section.id }} {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  /* Fallback image sits behind iframe, hidden once Spline loads */
  .hero__spline-fallback {
    position: absolute;
    inset: 0;
    z-index: -1;
    transition: opacity 0.6s ease;
  }

  .hero__spline-fallback img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__spline-fallback.is-hidden {
    opacity: 0;
    pointer-events: none;
  }

  {%- if section.settings.text_alignment == 'center' -%}
    #hero-{{ section.id }} .hero__content {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
    }
    #hero-{{ section.id }} .hero__headline { max-width: 18ch; }
    #hero-{{ section.id }} .hero__subtext  { max-width: 52ch; }
    #hero-{{ section.id }} .hero__actions  { justify-content: center; }
  {%- elsif section.settings.text_alignment == 'right' -%}
    #hero-{{ section.id }} .hero__content {
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      text-align: right;
    }
  {%- endif -%}
</style>

<script>
  (function () {
    var id = '{{ section.id }}';
    var splineEnabled = {{ use_3d | json }};
    var splineEl = document.getElementById('hero-spline-' + id);
    var fallbackEl = document.getElementById('hero-spline-fallback-' + id);

    if (!splineEnabled || !splineEl) return;

    /* Never load Spline on touch devices — WebGL is heavy and CSS hides it anyway */
    if (window.matchMedia('(pointer: coarse)').matches) return;

    var iframe = splineEl.querySelector('iframe');
    if (!iframe) return;

    /* Set src from data-src so the request only fires on capable devices */
    iframe.src = iframe.dataset.src;

    /* Hide fallback once Spline's WebGL scene initialises */
    if (fallbackEl) {
      iframe.addEventListener('load', function () {
        setTimeout(function () { fallbackEl.classList.add('is-hidden'); }, 800);
      });
    }
  })();
</script>

{% schema %}
{
  "name": "Hero",
  "tag": "section",
  "class": "section-hero",
  "settings": [
    {
      "type": "header",
      "content": "3D Experience"
    },
    {
      "type": "checkbox",
      "id": "enable_3d",
      "label": "Enable 3D / Spline experience",
      "default": false,
      "info": "Paste a Spline scene URL below. Spline is free at spline.design"
    },
    {
      "type": "text",
      "id": "spline_url",
      "label": "Spline scene embed URL",
      "info": "From Spline → Export → Viewer. Looks like: https://my.spline.design/..."
    },
    {
      "type": "header",
      "content": "Background Media"
    },
    {
      "type": "image_picker",
      "id": "fallback_image",
      "label": "Background image (also used as Spline fallback)",
      "info": "Shown while 3D loads, or when 3D is disabled"
    },
    {
      "type": "text",
      "id": "video_url",
      "label": "Background video URL (.mp4)",
      "info": "Used when 3D is disabled. Direct .mp4 URL only."
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "default": 50,
      "unit": "%"
    },
    {
      "type": "header",
      "content": "Text Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "New Collection — 2025"
    },
    {
      "type": "textarea",
      "id": "headline",
      "label": "Headline",
      "info": "Each line break creates a new reveal line",
      "default": "Elevated\nStreets.\nRefined\nEdge."
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Premium streetwear crafted for those who move with purpose. Limited drops. Unlimited identity."
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#f0ebe0"
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "text",
      "id": "cta_primary_label",
      "label": "Primary button label",
      "default": "Shop Collection"
    },
    {
      "type": "url",
      "id": "cta_primary_url",
      "label": "Primary button URL"
    },
    {
      "type": "text",
      "id": "cta_secondary_label",
      "label": "Secondary button label",
      "default": "Our Story"
    },
    {
      "type": "url",
      "id": "cta_secondary_url",
      "label": "Secondary button URL"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        { "value": "left",   "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right",  "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "min_height",
      "label": "Section height",
      "min": 60,
      "max": 100,
      "step": 5,
      "default": 100,
      "unit": "vh"
    },
    {
      "type": "checkbox",
      "id": "show_scroll_indicator",
      "label": "Show scroll indicator",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Hero",
      "settings": {
        "enable_3d": false,
        "eyebrow": "New Collection — 2025",
        "headline": "Elevated\nStreets.\nRefined\nEdge.",
        "subtext": "Premium streetwear crafted for those who move with purpose.",
        "cta_primary_label": "Shop Collection",
        "cta_secondary_label": "Our Story",
        "text_alignment": "left",
        "min_height": 100,
        "overlay_opacity": 50,
        "show_scroll_indicator": true
      }
    }
  ]
}
{% endschema %}
