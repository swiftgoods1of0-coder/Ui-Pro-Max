{%- assign collection = collections[section.settings.collection] -%}
{%- assign products_count = section.settings.products_count | default: 6 -%}

<section
  class="best-sellers"
  id="best-sellers-{{ section.id }}"
  style="
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background-color: {{ section.settings.bg_color }};
  "
>

  <!-- Ticker / Running Title -->
  {%- if section.settings.show_ticker and section.settings.ticker_text != blank -%}
    <div class="ticker" aria-hidden="true">
      <div class="ticker__inner">
        {%- for i in (1..8) -%}
          <span class="ticker__item">{{ section.settings.ticker_text }}</span>
          <span class="ticker__sep">—</span>
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}

  <div class="container">

    <div class="section-header" style="margin-bottom:clamp(40px,6vw,72px);" data-animate>
      {%- if section.settings.eyebrow != blank -%}
        <span class="section-eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      <h2 class="section-title">{{ section.settings.heading }}</h2>
      {%- if section.settings.subtext != blank -%}
        <p style="font-size:15px;color:var(--text-muted);max-width:56ch;margin-top:8px;line-height:1.7;">{{ section.settings.subtext }}</p>
      {%- endif -%}
    </div>

    <!-- Featured + Grid layout -->
    {%- if collection != blank and collection.products.size > 0 -%}

      {%- if section.settings.layout == 'editorial' -%}
        <!-- Editorial Layout: 1 large + grid -->
        <div class="best-sellers__editorial">
          {%- assign featured = collection.products.first -%}
          <div class="best-sellers__featured" data-animate>
            <a href="{{ featured.url }}">
              <div class="best-sellers__featured-media">
                {%- if featured.featured_image != blank -%}
                  {{
                    featured.featured_image
                    | image_url: width: 900
                    | image_tag:
                      loading: 'lazy',
                      widths: '400,600,800,900,1200',
                      sizes: '(max-width: 900px) 90vw, 50vw',
                      width: featured.featured_image.width,
                      height: featured.featured_image.height,
                      alt: featured.featured_image.alt | default: featured.title
                  }}
                {%- endif -%}
                <div class="best-sellers__featured-badge">
                  <span>{{ section.settings.featured_badge | default: 'Best Seller' }}</span>
                </div>
              </div>
              <div class="best-sellers__featured-info">
                <h3 class="best-sellers__featured-title">{{ featured.title }}</h3>
                <p class="best-sellers__featured-price">{{ featured.price | money }}</p>
              </div>
            </a>
          </div>

          <div class="best-sellers__grid">
            {%- for product in collection.products limit: products_count offset: 1 -%}
              <article class="product-card product-card--compact" data-animate data-animate-delay="{{ forloop.index }}">
                <a href="{{ product.url }}">
                  <div class="product-card__media">
                    {%- if product.featured_image != blank -%}
                      {{
                        product.featured_image
                        | image_url: width: 600
                        | image_tag:
                          loading: 'lazy',
                          widths: '200,300,450,600',
                          sizes: '(max-width: 480px) 50vw, (max-width: 900px) 33vw, 25vw',
                          width: product.featured_image.width,
                          height: product.featured_image.height,
                          alt: product.featured_image.alt | default: product.title
                      }}
                    {%- endif -%}
                    {%- if section.settings.show_quick_add -%}
                      {%- assign _variant = product.selected_or_first_available_variant -%}
                      {%- if _variant != blank -%}
                        <button class="product-card__quick-add" data-add-to-cart="{{ _variant.id }}">Quick Add</button>
                      {%- endif -%}
                    {%- endif -%}
                  </div>
                  <div class="product-card__info">
                    <p class="product-card__title">{{ product.title }}</p>
                    <div class="product-card__price">
                      {%- if product.compare_at_price > product.price -%}
                        <span class="price price--sale">{{ product.price | money }}</span>
                        <span class="price price--compare">{{ product.compare_at_price | money }}</span>
                      {%- else -%}
                        <span class="price">{{ product.price | money }}</span>
                      {%- endif -%}
                    </div>
                  </div>
                </a>
              </article>
            {%- endfor -%}
          </div>
        </div>

      {%- else -%}
        <!-- Standard Grid -->
        <div class="products-grid" style="--cols:{{ section.settings.columns | default: 3 }};">
          {%- for product in collection.products limit: products_count -%}
            <article class="product-card" data-animate data-animate-delay="{{ forloop.index }}">
              <a href="{{ product.url }}">
                <div class="product-card__media">
                  {%- if forloop.first and section.settings.show_numbered -%}
                    <div class="product-card__number">01</div>
                  {%- elsif section.settings.show_numbered -%}
                    <div class="product-card__number">0{{ forloop.index }}</div>
                  {%- endif -%}
                  {%- if product.featured_image != blank -%}
                    {{
                      product.featured_image
                      | image_url: width: 700
                      | image_tag:
                        loading: 'lazy',
                        widths: '200,400,600,700',
                        sizes: '(max-width: 480px) 50vw, (max-width: 900px) 33vw, 25vw',
                        width: product.featured_image.width,
                        height: product.featured_image.height,
                        alt: product.featured_image.alt | default: product.title
                    }}
                  {%- endif -%}
                  {%- if section.settings.show_quick_add -%}
                    {%- assign _variant = product.selected_or_first_available_variant -%}
                    {%- if _variant != blank -%}
                      <button class="product-card__quick-add" data-add-to-cart="{{ _variant.id }}">Quick Add</button>
                    {%- endif -%}
                  {%- endif -%}
                </div>
                <div class="product-card__info">
                  <p class="product-card__title">{{ product.title }}</p>
                  <div class="product-card__price">
                    {%- if product.compare_at_price > product.price -%}
                      <span class="price price--sale">{{ product.price | money }}</span>
                      <span class="price price--compare">{{ product.compare_at_price | money }}</span>
                    {%- else -%}
                      <span class="price">{{ product.price | money }}</span>
                    {%- endif -%}
                  </div>
                </div>
              </a>
            </article>
          {%- endfor -%}
        </div>
      {%- endif -%}

    {%- else -%}
      <p style="color:var(--text-dim);font-size:14px;letter-spacing:0.1em;">Please select a collection in the customizer.</p>
    {%- endif -%}

    {%- if section.settings.cta_label != blank -%}
      <div style="text-align:center;margin-top:clamp(40px,6vw,72px);" data-animate>
        <a href="{{ collection.url | default: routes.collections_url }}" class="btn btn--secondary btn--lg">
          {{ section.settings.cta_label }}
        </a>
      </div>
    {%- endif -%}

  </div>
</section>

<style>
  .ticker {
    overflow: hidden;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    padding: 14px 0;
    margin-bottom: clamp(48px, 8vw, 96px);
    white-space: nowrap;
  }

  .ticker__inner {
    display: inline-flex;
    animation: ticker 20s linear infinite;
  }

  .ticker__item {
    font-family: var(--font-display);
    font-size: clamp(18px, 2.5vw, 28px);
    font-style: italic;
    color: var(--text-muted);
    letter-spacing: 0.05em;
    padding: 0 24px;
  }

  .ticker__sep {
    color: var(--accent);
    padding: 0 8px;
  }

  @keyframes ticker {
    from { transform: translateX(0); }
    to   { transform: translateX(-33.333%); }
  }

  /* Editorial layout */
  .best-sellers__editorial {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(16px, 2vw, 32px);
  }

  .best-sellers__featured-media {
    aspect-ratio: 3/4;
    overflow: hidden;
    position: relative;
    margin-bottom: 20px;
    background: var(--bg-card);
  }

  .best-sellers__featured-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s cubic-bezier(0.4,0,0.2,1);
  }

  .best-sellers__featured:hover .best-sellers__featured-media img {
    transform: scale(1.04);
  }

  .best-sellers__featured-badge {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    background: var(--accent);
    color: var(--bg);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    padding: 10px;
    text-align: center;
  }

  .best-sellers__featured-title {
    font-family: var(--font-display);
    font-size: clamp(20px, 2.5vw, 32px);
    font-weight: 400;
    color: var(--text);
    margin-bottom: 8px;
  }

  .best-sellers__featured-price {
    font-family: var(--font-display);
    font-size: 24px;
    color: var(--accent);
  }

  .best-sellers__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(12px, 1.5vw, 20px);
    align-content: start;
  }

  .product-card__number {
    position: absolute;
    top: 16px;
    right: 16px;
    font-family: var(--font-display);
    font-size: 48px;
    font-style: italic;
    color: rgba(240,235,224,0.12);
    line-height: 1;
    z-index: 1;
    pointer-events: none;
  }

  @media (max-width: 768px) {
    .best-sellers__editorial { grid-template-columns: 1fr; }
    .best-sellers__grid { grid-template-columns: 1fr 1fr; }
  }
</style>

{% schema %}
{
  "name": "Best Sellers",
  "tag": "section",
  "class": "section-best-sellers",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label",
      "default": "Most Wanted"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "default": "Best Sellers"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Supporting text"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA button label",
      "default": "View All"
    },
    {
      "type": "header",
      "content": "Collection"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_count",
      "label": "Products to show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 6
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout style",
      "options": [
        { "value": "grid",      "label": "Standard grid" },
        { "value": "editorial", "label": "Editorial (1 large + grid)" }
      ],
      "default": "editorial"
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Columns (standard grid)",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "3"
    },
    {
      "type": "checkbox",
      "id": "show_quick_add",
      "label": "Show quick add button",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_numbered",
      "label": "Show rank numbers (grid mode)",
      "default": false
    },
    {
      "type": "header",
      "content": "Ticker"
    },
    {
      "type": "checkbox",
      "id": "show_ticker",
      "label": "Show scrolling ticker",
      "default": true
    },
    {
      "type": "text",
      "id": "ticker_text",
      "label": "Ticker text",
      "default": "Swift Goods — Premium Streetwear"
    },
    {
      "type": "text",
      "id": "featured_badge",
      "label": "Featured product badge text",
      "default": "Best Seller"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#0f0f0f"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 40,
      "max": 200,
      "step": 8,
      "default": 120,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 40,
      "max": 200,
      "step": 8,
      "default": 120,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "Best Sellers",
      "settings": {
        "eyebrow": "Most Wanted",
        "heading": "Best Sellers",
        "cta_label": "View All",
        "products_count": 6,
        "layout": "editorial",
        "show_ticker": true,
        "ticker_text": "Swift Goods — Premium Streetwear"
      }
    }
  ]
}
{% endschema %}
