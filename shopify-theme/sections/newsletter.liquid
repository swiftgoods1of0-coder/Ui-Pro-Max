<section
  class="newsletter"
  id="newsletter-{{ section.id }}"
  data-newsletter
  style="
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background-color: {{ section.settings.bg_color }};
    border-top: 1px solid {{ section.settings.border_color }};
    border-bottom: 1px solid {{ section.settings.border_color }};
  "
>
  <div class="container">
    <div class="newsletter__inner newsletter__inner--{{ section.settings.layout }}">

      <!-- Left: Text -->
      <div class="newsletter__text-col">
        {%- if section.settings.eyebrow != blank -%}
          <span class="newsletter__label" data-animate>{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        <h2 class="newsletter__heading" data-animate data-animate-delay="1">
          {{ section.settings.heading }}
        </h2>
        {%- if section.settings.subtext != blank -%}
          <p class="newsletter__text" data-animate data-animate-delay="2">{{ section.settings.subtext }}</p>
        {%- endif -%}

        {%- if section.settings.perks != blank -%}
          <ul class="newsletter__perks" data-animate data-animate-delay="3">
            {%- assign perks = section.settings.perks | split: ',' -%}
            {%- for perk in perks -%}
              <li>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" style="color:var(--accent);flex-shrink:0;" aria-hidden="true">
                  <polyline points="20 6 9 17 4 12"/>
                </svg>
                {{ perk | strip }}
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>

      <!-- Right: Form -->
      <div class="newsletter__form-col" data-animate data-animate-delay="2">

        {% form 'customer', id: 'newsletter-form-' | append: section.id, class: 'newsletter__form', data-newsletter-form: '' %}
          <input type="hidden" name="form_type" value="customer">
          <input type="hidden" name="utf8" value="✓">
          <input type="hidden" name="customer[tags]" value="newsletter">

          <div class="newsletter__field">
            {%- if section.settings.show_name -%}
              <input
                type="text"
                name="customer[first_name]"
                class="newsletter__input"
                placeholder="{{ section.settings.name_placeholder | default: 'First name' }}"
                style="margin-bottom:12px;"
              >
            {%- endif -%}
            <input
              type="email"
              name="customer[email]"
              class="newsletter__input"
              placeholder="{{ section.settings.email_placeholder | default: 'Your email address' }}"
              required
              autocomplete="email"
            >
          </div>

          <button type="submit" class="btn btn--primary btn--full btn--lg">
            {{ section.settings.btn_label | default: 'Subscribe' }}
          </button>

          <p class="newsletter__disclaimer">
            {{ section.settings.disclaimer | default: 'By subscribing you agree to our Privacy Policy and consent to receive updates from Swift Goods.' }}
          </p>
        {% endform %}

        <!-- Success State -->
        <div class="newsletter__success" data-newsletter-success aria-live="polite">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true" style="color:var(--accent);margin-bottom:12px;">
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
            <polyline points="22 4 12 14.01 9 11.01"/>
          </svg>
          <p>{{ section.settings.success_message | default: "You're in. Welcome to Swift Goods." }}</p>
        </div>

      </div>
    </div>
  </div>
</section>

<style>
  #newsletter-{{ section.id }} .newsletter__inner {
    display: grid;
    align-items: center;
  }

  #newsletter-{{ section.id }} .newsletter__inner--side-by-side {
    grid-template-columns: 1fr 1fr;
    gap: clamp(40px, 6vw, 96px);
  }

  #newsletter-{{ section.id }} .newsletter__inner--centered {
    grid-template-columns: 1fr;
    max-width: 560px;
    margin: 0 auto;
    text-align: center;
    justify-items: center;
  }

  #newsletter-{{ section.id }} .newsletter__inner--centered .newsletter__heading { text-align: center; }
  #newsletter-{{ section.id }} .newsletter__inner--centered .newsletter__text    { text-align: center; }
  #newsletter-{{ section.id }} .newsletter__inner--centered .newsletter__perks   { justify-content: center; }

  .newsletter__perks {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: 24px;
  }

  .newsletter__perks li {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 13px;
    color: var(--text-muted);
    letter-spacing: 0.04em;
  }

  @media (max-width: 768px) {
    #newsletter-{{ section.id }} .newsletter__inner--side-by-side {
      grid-template-columns: 1fr;
      gap: 48px;
    }
  }
</style>

{% schema %}
{
  "name": "Newsletter",
  "tag": "section",
  "class": "section-newsletter",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Stay Informed"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Join the Inner Circle"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Early access to drops, exclusive offers, and behind-the-scenes content. No spam — only what matters."
    },
    {
      "type": "textarea",
      "id": "perks",
      "label": "Perks list (comma separated)",
      "default": "Early access to limited drops, Members-only pricing, Exclusive editorial content"
    },
    {
      "type": "header",
      "content": "Form"
    },
    {
      "type": "checkbox",
      "id": "show_name",
      "label": "Show name field",
      "default": false
    },
    {
      "type": "text",
      "id": "name_placeholder",
      "label": "Name placeholder",
      "default": "First name"
    },
    {
      "type": "text",
      "id": "email_placeholder",
      "label": "Email placeholder",
      "default": "Your email address"
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Button label",
      "default": "Subscribe"
    },
    {
      "type": "textarea",
      "id": "disclaimer",
      "label": "Disclaimer text"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "You're in. Welcome to Swift Goods."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "side-by-side", "label": "Side by side" },
        { "value": "centered",     "label": "Centered" }
      ],
      "default": "side-by-side"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#0f0f0f"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "default": "#1a1a1a"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 40,
      "max": 200,
      "step": 8,
      "default": 96,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 40,
      "max": 200,
      "step": 8,
      "default": 96,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "Newsletter",
      "settings": {
        "eyebrow": "Stay Informed",
        "heading": "Join the Inner Circle",
        "subtext": "Early access to drops, exclusive offers, and behind-the-scenes content.",
        "btn_label": "Subscribe",
        "layout": "side-by-side"
      }
    }
  ]
}
{% endschema %}
